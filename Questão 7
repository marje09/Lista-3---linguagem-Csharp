using System;
using System.Globalization;

namespace Programa {
    class Program {
        static void Main(string[] args) {
            CultureInfo CI = CultureInfo.InvariantCulture;

            int codigo;
            string tipoViagem;
            double valor = 0.0;

            Console.WriteLine("1 - Morros (R$120,00)");
            Console.WriteLine("2 - Barreirinhas (R$200,00)");
            Console.WriteLine("3 - Bacabeira (R$50,00)");
            Console.WriteLine("4 - Rosário (R$80,00)");
            Console.Write("Informe o código do destino: ");
            codigo = int.Parse(Console.ReadLine());

            switch (codigo) {
                case 1: valor = 120.0; break;
                case 2: valor = 200.0; break;
                case 3: valor = 50.0; break;
                case 4: valor = 80.0; break;
                default:
                    Console.WriteLine("Código inválido!");
                    return;
            }

            Console.Write("A viagem é de ida e volta (S/N)? ");
            tipoViagem = Console.ReadLine().ToUpper();

            if (tipoViagem == "S") {
                valor *= 2;
                valor -= valor * 0.10;
            }

            Console.WriteLine("Valor total da passagem: R$ " + valor.ToString("F2", CI));
        }
    }
}
